# Semantic PYQ Analyzer & Study Heatmap - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="Semantic PYQ Analyzer"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL with pgvector)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/pyq_analyzer

# Embedding Model (local, runs via sentence-transformers)
# Recommended: all-MiniLM-L6-v2 (384 dims, fast, English)
# Or: all-mpnet-base-v2 (768 dims, higher quality)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Ollama (local LLM for AI chat)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# File Storage
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=50

# Analysis Settings
TOP_K_MATCHES=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# CORS (frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
