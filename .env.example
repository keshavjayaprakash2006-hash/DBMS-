# ==============================================================================
# Semantic PYQ Analyzer & Study Heatmap - Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in the Render Web Service and Static Site dashboard for production deployment.
# NEVER commit real credentials, database passwords, or API keys to git.
# ==============================================================================

# ─── Application Configuration ───────────────────────────────────────────────
APP_NAME="Semantic PYQ Analyzer"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PORT=8000
LOG_LEVEL=INFO

# ─── Database (Neon PostgreSQL + pgvector) ───────────────────────────────────
# Format: postgresql+psycopg://user:password@ep-xyz.region.aws.neon.tech/dbname?sslmode=require
# Obtain this from your Neon Console (https://console.neon.tech)
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── AI Study Assistant (Google Gemini API) ──────────────────────────────────
# Obtain a free API key at Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=45

# ─── Vector Embeddings Configuration ─────────────────────────────────────────
# "gemini": Uses Google Gemini text-embedding-004 with 384 dimensions.
#           Zero memory footprint on 512MB RAM Render Web Service instances.
# "local":  Uses Sentence-Transformers all-MiniLM-L6-v2 (offline PyTorch).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSION=384

# ─── Cloud Object Storage (Supabase Storage) ─────────────────────────────────
# Free 1GB bucket for persistent PDF, DOCX, and TXT note files.
# Obtain from your Supabase Project Settings -> API (https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=documents

# ─── File Handling Limits ────────────────────────────────────────────────────
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=50

# ─── Analysis & RAG Parameters ───────────────────────────────────────────────
TOP_K_MATCHES=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── CORS Origins (Backend) ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, or * for public access
CORS_ORIGINS=https://semantic-pyq-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# ─── Frontend Environment Variable (Render Static Site) ──────────────────────
# Set in Render Static Site environment settings so the SPA communicates with your live backend:
VITE_API_URL=https://semantic-pyq-backend.onrender.com
